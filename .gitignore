# .gitignore — files and folders Git must NEVER save
# (PARSH'S Diner 3D)

# ---- Secrets: passwords, keys, tokens (never upload) ----
.env
.env.*
!.env.example

# ---- Downloaded code and build output (can be rebuilt anytime) ----
node_modules/
dist/
build/
.cache/
.vite/

# ---- Vercel's local settings folder ----
.vercel/

# ---- Claude Code personal settings on this computer ----
.claude/settings.local.json
.claude/launch.json

# ---- Log files ----
*.log
npm-debug.log*

# ---- Windows and Mac system files ----
Thumbs.db
desktop.ini
.DS_Store

# ---- Editor settings ----
.vscode/
.idea/

# ---- Temporary files ----
*.tmp
*.bak
